{
  "name": "@euclid-in-motion/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm test && npm run validate:catalog && vite build",
    "dev": "vite --port 8000",
    "build": "npm run validate:catalog && npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.quality.json --pretty false",
    "validate:catalog": "node scripts/validateCatalog.ts"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
